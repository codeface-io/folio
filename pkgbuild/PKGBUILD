pkgname=folio
pkgver=0.2.0
pkgrel=1
pkgdesc="Omarchy's file manager: quiet, keyboard-first, and following the theme"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=(
  'glib2'
  'hicolor-icon-theme'
  'libarchive'
  'qt6-base'
  'qt6-declarative'
  'qt6-imageformats'
  'qt6-multimedia'
  'qt6-wayland'
  'xdg-utils'
  'zlib'
)
optdepends=(
  'qt6-webengine: PDF previews (Qt PDF)'
  'ffmpegthumbnailer: video thumbnails'
  'poppler: PDF thumbnails'
  'glycin: HEIC, JPEG XL and other image thumbnails'
  'gvfs: browsing tailnet machines over SFTP'
  'tailscale: listing tailnet machines'
  'dropbox-cli: Dropbox sync status and share links'
  'localsend: sharing with nearby devices'
  'xdg-terminal-exec: Open Terminal Here'
)
makedepends=('cmake' 'gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/folio "$pkgdir/usr/bin/folio"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/folio.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/folio.svg"
  install -Dm644 "$startdir/folio.desktop" "$pkgdir/usr/share/applications/folio.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
